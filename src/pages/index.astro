---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import ProductDescription from '../components/product-description/ProductDescription.jsx';
import PricingPackages from '../components/pricing-packages/PricingPackages.jsx';
import PricingAnimations from '../components/pricing-animations/PricingAnimations.jsx';
import HowItWorks from '../components/how-it-works/HowItWorks.jsx';
import Faqs from '../components/faqs/Faqs.jsx';
import Footer from '../components/Footer.jsx';
import HeroCta from '../components/HeroCta.jsx';
import ContactForm from "../components/forms/ContactForm.jsx";
import OrderForm from "../components/forms/OrderForm.jsx";
import PromoModal from '../components/PromoModal.jsx';
---

<Layout title="Fotolavoretti - Landing Page">
  <Header client:load />
  <section class="hero">  
  <div class="img-container">
        <img src="mariposa-hero.jpg"/>
  </div>  
  <div class="title-container">
          <h1 class="hero-title">Trasformo i lavoretti dei tuoi bambini in ricordi digitali che restano</h1>
<h2 class="hero-subtitle">PDF, galleria HD, video e animazioni: tutto raccolto in un ricordo ordinato, pronto da conservare e condividere.</h2>
  </div>
    <HeroCta client:load />
  </section>     
  <main>
    <section id="product-description" >
      <ProductDescription client:load/>
    </section>    
    <section id="pricing-packages">
      <PricingPackages client:load />
    </section>    
    <section id="pricing-animations">
      <PricingAnimations client:load />
    </section>    
    <section id="how-it-works">
      <HowItWorks client:load />
    </section>    
    <section id="faqs">
      <Faqs client:load />
    </section>
  </main>  
  <section class="footer">
    <img src="ig_qr.png" alt="QR Code per Instagram">
    <div class="footer-links">
      <a href="/terms-of-service">Termini del servizio</a>
      <a href="/privacy-policy">Privacy e GDPR</a>
      <a href="/cookie-policy">Cookie policy</a>
      <a href="/politica-di-cancellazione">Politica di Cancellazione</a>
    </div>
  </section>
  <br>
  <br>
  ---

  <PromoModal client:load />

</Layout>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 4rem;
    padding-bottom: 1rem;

    text-align: center;
    border-bottom: 1px solid var(--border-color, #ccc);
  }

  .footer img {
    max-width: 150px;
    height: auto;
  }

  .footer-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem; /* Increased gap for better spacing in a row */
    font-size: 1.5rem;
  }

  .footer-links a {
    color: var(--text-color, #333);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }
</style>
