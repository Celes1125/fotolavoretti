---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Offerta Speciale Natale">
  <main class="container">
    <h1>Card di Natale Personalizzate</h1>
    <p>
      Questa pagina conterrà i dettagli completi dell'offerta per le card di Natale e i moduli per effettuare l'ordine.
    </p>
    <p>
      A breve disponibile!
    </p>
  </main>
</Layout>

<style>
  main {
    padding: 4rem 2rem;
    text-align: center;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
  }
  h1 {
    font-size: var(--font-size-xl);
    color: var(--color-secondary);
  }
  p {
    font-size: var(--font-size-md);
  }
</style>
