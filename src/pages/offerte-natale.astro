---
import Layout from '../layouts/Layout.astro';
import ChristmasOrderModal from '../components/forms/ChristmasOrderModal.jsx';
---

<Layout title="Offerta Speciale Natale" breadcrumbs={[{ text: 'Home', href: '/' }, { text: 'Offerta Speciale Natale', href: '/offerte-natale' }]}>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <img src='/fotolavoretti_logo_natale.png' alt="Logo Natalizio Fotolavoretti">
      <h1>Offerta Speciale Natale!</h1>
      <p class="subtitle">Crea le tue card di Natale personalizzate.</p>
      <p class="deadline">Disponibile fino al 22 Dicembre!</p>
    </section>

    <!-- Intro Section -->
    <section class="intro container">
      <p>
        Trasformo i disegni dei tuoi figli in auguri natalizi animati, personalizzati e pronti da condividere. 
        Ogni cartolina nasce dal disegno originale del bambino e include animazione, musica e un messaggio speciale per le feste. 
        Ricevi il video in formato ottimizzato, pronto da condividere su WhatsApp e Instagram (9:16).
      </p>
    </section>

    <!-- Options Section -->
    <section class="options-container">
      <h2 class="main-title">Scegli la tua animazione</h2>
      <div class="cards-grid">
        <!-- Opzione 1 -->
        <div class="card" data-card-name="Opzione 1">
          <div class="card-header">
            <h3 class="package-name">Personaggio animato</h3>
          </div>
          <div class="collapsible-content">
            <div class="card-body">
              <video class="video-placeholder" src="/videos/animation-standard.webm" autoplay loop muted playsinline></video>
              <p class="description">Un personaggio creato dal tuo piccolo prende vita e lo saluta con un messaggio standard: lo ringrazia per averlo disegnato e gli augura un felice Natale.</p>
              <p>Durata: 15–20 secondi.</p>
              <div class="features-section">
                <p class="section-label">Include:</p>
                <ul>
                  <li><span class="check-icon">✔</span>Video ottimizzato (WhatsApp / Instagram)</li>
                  <li><span class="check-icon">✔</span>Immagine quadrata del saluto natalizio</li>
                  <li><span class="check-icon">✔</span>Clip art in regalo ricavata dal disegno</li>
                </ul>
              </div>
              <div class="target-section">
                <p class="section-label">Cosa mi serve:</p>
                <ul>
                  <li><span class="check-icon">👉</span>Foto del disegno del personaggio</li>
                </ul>
              </div>
            </div>
            <div class="card-footer">
              <button class="cta-button" data-option="1">Prenota Opzione 1 (€15)</button>
            </div>
          </div>
        </div>

        <!-- Opzione 2 -->
        <div class="card highlighted" data-card-name="Opzione 2">
          <div class="card-header">
            <h3 class="package-name">Babbo Natale animato</h3>
          </div>
          <div class="collapsible-content">
            <div class="card-body">
              <video class="video-placeholder" src="/videos/animation-custom.webm" autoplay loop muted playsinline></video>
              <p class="description">Un Babbo Natale disegnato dal tuo piccolo prende vita e gli rivolge un messaggio personalizzato, citando il suo nome.</p>
              <p>Durata: 15–20 secondi.</p>
              <div class="features-section">
                <p class="section-label">Include:</p>
                <ul>
                  <li><span class="check-icon">✔</span>Video ottimizzato (WhatsApp / Instagram)</li>
                  <li><span class="check-icon">✔</span>Immagine quadrata del saluto natalizio</li>
                  <li><span class="check-icon">✔</span>Clip art in regalo ricavata dal disegno</li>
                </ul>
              </div>
              <div class="target-section">
                <p class="section-label">Cosa mi serve:</p>
                <ul>
                  <li><span class="check-icon">👉</span>Foto del disegno di Babbo Natale</li>
                  <li><span class="check-icon">👉</span>Nome del bambino</li>
                </ul>
              </div>
            </div>
            <div class="card-footer">
              <button class="cta-button" data-option="2">Prenota Opzione 2 (€20)</button>
            </div>
          </div>
        </div>

        <!-- Opzione 3 -->
        <div class="card" data-card-name="Opzione 3">
          <div class="card-header">
            <h3 class="package-name">Disegno con audio familiare</h3>
          </div>
          <div class="collapsible-content">
            <div class="card-body">
              <video class="video-placeholder" src="/videos/animation-standard.webm" autoplay loop muted playsinline></video>
              <p class="description">Un disegno natalizio si anima con effetti magici, accompagnato dall’audio di auguri della tua famiglia.</p>
              <p>Durata: 15–25 secondi.</p>
              <div class="features-section">
                <p class="section-label">Include:</p>
                <ul>
                  <li><span class="check-icon">✔</span>Video ottimizzato (WhatsApp / Instagram)</li>
                  <li><span class="check-icon">✔</span>Immagine quadrata del saluto natalizio</li>
                  <li><span class="check-icon">✔</span>Clip art in regalo ricavata dal disegno</li>
                </ul>
              </div>
              <div class="target-section">
                <p class="section-label">Cosa mi serve:</p>
                <ul>
                  <li><span class="check-icon">👉</span>Foto del disegno natalizio</li>
                  <li><span class="check-icon">👉</span>Audio con il tuo messaggio di auguri</li>
                </ul>
              </div>
            </div>
            <div class="card-footer">
              <button class="cta-button" data-option="3">Prenota Opzione 3 (€25)</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Instructions Section -->
    <section class="instructions container">
      <h2>Come funziona</h2>
      <div class="instructions-grid">
        <div class="instruction-step">
          <h4>1. Scegli la tua cartolina</h4>
          <p>Clicca sul pulsante del prodotto che preferisci per compilare il modulo d’ordine. Ti contatteremo al più presto.</p>
        </div>
        <div class="instruction-step">
          <h4>2. Inviaci foto e audio e conferma il pagamento</h4>
          <p>Ti contatteremo tramite Instagram o WhatsApp, secondo la tua preferenza. Ti chiederemo i materiali e ti invieremo il link per il pagamento per confermare l'ordine.</p>
        </div>
        <div class="instruction-step">
          <h4>3. Ricevi il tuo prodotto</h4>
          <p>Entro i tempi indicati consegneremo il tuo prodotto finito, pronto da condividere.</p>
        </div>
      </div>
    </section>

    <ChristmasOrderModal client:load />

  </main>
</Layout>

<script>
  // Modal script
  const modalButtons = document.querySelectorAll('.cta-button[data-option]');
  modalButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation(); // Prevent click from bubbling up to the card header
      const selectedOption = button.getAttribute('data-option');
      const event = new CustomEvent('open-christmas-modal', { detail: { option: selectedOption } });
      document.dispatchEvent(event);
    });
  });

  // Accordion script
  const allCards = document.querySelectorAll('.card');
  allCards.forEach(card => {
    const header = card.querySelector('.card-header');
    header.addEventListener('click', () => {
      // This only runs on mobile where the header is clickable
      if (window.innerWidth < 1024) {
        const isOpen = card.classList.contains('open');
        
        // Close all cards
        allCards.forEach(c => c.classList.remove('open'));

        // If the clicked card was not open, open it
        if (!isOpen) {
          card.classList.add('open');
        }
      }
    });
  });
</script>

<style>
  /* General Container */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Hero Section (Existing Styles) */
  .hero { text-align: center; padding: 4rem 2rem; color: black; }
  .hero img { object-fit: contain; height:30rem; width: 30rem; }
  .hero h1 { font-size: var(--font-size-xl); color: blue; margin: 0; }
  .hero .subtitle { font-size: var(--font-size-md); margin: 0.5rem 0; }
  .hero .deadline { font-size: var(--font-size-base); font-weight: var(--fw-bold); color: var(--color-primary); }

  /* Intro Section (Existing Styles) */
  .intro { widht: 60%; margin: auto; padding: 0; text-align: center; font-size: var(--font-size-lg); line-height: 1.5; }

  /* New Options Section Styles */
  .options-container {
    width: 90vw;
    max-width: 1100px;
    margin: auto;
    padding: 3rem 1rem;
    text-align: center;
  }
  .main-title {
    font-size: var(--font-size-lg);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    align-items: stretch;
  }
  .card {
    background: var(--color-background);
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-accent);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.06);
  }
  .card.highlighted {
    border: 2px solid var(--color-primary);
  }
  .card.highlighted .package-name {
    color: var(--color-primary);
  }
  .card-header {
    padding: 1.5rem 1.5rem 0.5rem 1.5rem;
    border-bottom: 1px solid var(--color-accent);
    text-align: center;
  }
  .package-name {
    font-size: var(--font-size-md);
    margin: 0 0 10px 0;
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }
  .collapsible-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-body {
    padding: 1.5rem;
    flex-grow: 1;
    text-align: left;
  }
  .video-placeholder {
    width: 100%;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-accent);
  }
  .description {
    font-size: var(--font-size-sm);
    color: var(--color-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }
  .section-label {
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    margin-bottom: 1rem;
    margin-top: 0;
  }
  .features-section ul, .target-section ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }
  .features-section li, .target-section li {
    margin-bottom: 0.8rem;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
  }
  .check-icon {
    color: var(--color-secondary);
    margin-right: 10px;
    flex-shrink: 0;
  }
  .card.highlighted .check-icon {
    color: var(--color-primary);
  }
  .card-footer {
    padding: 1.5rem;
    margin-top: auto;
  }
  .cta-button {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: 6px;
    background-color: var(--color-primary);
    color: white;
    font-weight: var(--fw-semibold);
    font-size: var(--font-size-base);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .cta-button:hover {
    background-color: var(--color-secondary);
  }

  /* Instructions Section (Existing Styles) */
  .instructions { padding: 4rem 2rem; }
  .instructions h2 { text-align: center; margin-bottom: 2rem; font-size: var(--font-size-lg); }
  .instructions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; text-align: center; }
  .instruction-step h4 { font-size: var(--font-size-md); color: var(--color-secondary); }

  /* Mobile-specific accordion styles */
  @media (max-width: 1023px) {
    .options-container {
      width: 100%;
      padding: 2rem 1rem;
    }
    .cards-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .card-header {
      cursor: pointer;
      position: relative;
    }
    .card-header::after {
      content: '+';
      position: absolute;
      right: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 2rem;
      color: var(--color-secondary);
      font-weight: var(--fw-light);
    }
    .card.open .card-header::after {
      content: '−';
    }
    .collapsible-content {
      display: block;
      flex-grow: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease-out;
    }
    .card.open .collapsible-content {
      max-height: 1000px; /* Large enough to fit content */
      transition: max-height 0.5s ease-in;
    }
  }
</style>
